{
  "servers": {
    "lua-language-server": {
      "settings": {
        "Lua": {
          "workspace": {
            "checkThirdParty": false,
            "library": ["${3rd}/luv/library"]
          },
          "diagnostics": {
            "globals": ["vim", "require", "describe", "it", "before_each", "after_each", "pending"]
          },
          "telemetry": {
            "enable": false
          },
          "hint": {
            "enable": true,
            "setType": true
          }
        }
      }
    },
    "bashls": {
      "settings": {
        "bashIde": {
          "globPattern": "*@(.sh|.zsh|.bash|.zshenv|.zshrc|.bashrc|.bash_profile|.profile|.zprofile|.zlogin|.zlogout|.zshenv|.zcompdump|.zcompdump.zwc)",
          "enableSourceErrorDiagnostics": true,
          "includeAll": true
        }
      }
    },
    "yamlls": {
      "settings": {
        "yaml": {
          "schemas": {
            "https://json.schemastore.org/github-workflow.json": ".github/workflows/*",
            "https://json.schemastore.org/github-action.json": ".github/actions/*",
            "https://json.schemastore.org/circleciconfig.json": ".circleci/config.yml",
            "https://json.schemastore.org/docker-compose.json": ["docker-compose.yml", "docker-compose.yaml", "compose.yml", "compose.yaml"]
          },
          "validate": true,
          "completion": true,
          "hover": true
        }
      }
    },
    "dockerls": {},
    "marksman": {}
  }
}